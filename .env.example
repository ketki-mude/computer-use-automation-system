# Copy to .env and fill in. .env is gitignored.

# Gemini: used only for discovery and capability selection. Replay never calls an LLM.
GEMINI_API_KEY=

# Mock bank sign-on (synthetic demo credentials). The automation reads these via
# secret references; they are never shown to the LLM or written to artifacts/logs.
MOCKBANK_USER=teller01
MOCKBANK_PASSWORD=Demo#2026
MOCKBANK_PORT=8000
MOCKBANK_SESSION_TIMEOUT_S=900
