# Optional. Copy to .env (gitignored) and fill in what you need; everything has a default.

# Gemini: used only to learn new tasks (discovery) and to pick a capability for a request.
# Replay never calls an LLM. Without a key, known requests still run, and the three offline
# demo requests learn from scripted decisions.
GEMINI_API_KEY=
# UI_AUTOMATION_DISCOVERY_MODEL=gemini-3.8-flash
# UI_AUTOMATION_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview

# Ports of the web pages (requests page + control room) and of the mock bank.
# UI_AUTOMATION_OPERATOR_PORT=8001
# UI_AUTOMATION_BANK_PORT=8100

# The mock bank's synthetic teller sign-on. The demo provides it automatically; set these only
# to change it. The automation reads them through secret references: they are never shown to
# the LLM or written to artifacts or logs.
# MOCK_BANK_USER=
# MOCK_BANK_PASSWORD=
# MOCK_BANK_SESSION_TIMEOUT_S=900
